{
	"name": "mailster-recaptcha",
	"version": "2.0.2",
	"description": "reCAPTCHA integration for Mailster forms.",
	"author": "Xaver <xaver@everpress.co>",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"recaptcha",
		"mailster",
		"newsletter",
		"captcha"
	],
	"homepage": "https://mailster.co",
	"repository": {
		"type": "git",
		"url": "https://github.com/everpress-co/mailster-recaptcha.git"
	},
	"bugs": {
		"url": "https://github.com/everpress-co/mailster-recaptcha/issues"
	},
	"files": [
		"*.php",
		"build",
		"classes",
		"assets",
		"views",
		"readme.txt"
	],
	"devDependencies": {
		"@wordpress/scripts": "^36.1.0"
	},
	"scripts": {
		"build": "wp-scripts build assets/js/*",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start assets/js/*",
		"lint": "npm run lint:js && npm run lint:pkg-json",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"lint:js": "wp-scripts lint-js assets/js/recaptcha.js",
		"packages-update": "wp-scripts packages-update"
	}
}
